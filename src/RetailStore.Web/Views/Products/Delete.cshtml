@model Product
@{
    ViewData["Title"] = "Delete product";
    var hasSales = (bool)ViewData["HasSales"]!;
}

<div class="page-title">
    <h1>Delete product</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to list</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                @if (hasSales)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> This product has sales and cannot be deleted.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this product? Its demand forecast will be deleted too.
                    </div>
                }

                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category.Name</dd>

                    <dt class="col-sm-4">Supplier</dt>
                    <dd class="col-sm-8">@Model.Supplier.Name</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">₴@(Model.UnitPrice.ToString("N2"))</dd>

                    <dt class="col-sm-4">Stock</dt>
                    <dd class="col-sm-8">@Model.StockQuantity</dd>

                    <dt class="col-sm-4">Min stock</dt>
                    <dd class="col-sm-8">@Model.MinStock</dd>
                </dl>

                @if (hasSales)
                {
                    <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Back to details</a>
                }
                else
                {
                    <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post" class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                        <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
