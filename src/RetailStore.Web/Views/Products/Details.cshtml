@model Product
@{
    ViewData["Title"] = Model.Name;
    var recentSales = (List<SaleItem>)ViewData["RecentSales"]!;
}

<div class="page-title">
    <h1>@Model.Name</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to list</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Product information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Category</dt>
                    <dd class="col-sm-7">@Model.Category.Name</dd>

                    <dt class="col-sm-5">Supplier</dt>
                    <dd class="col-sm-7">
                        @Model.Supplier.Name
                        <div class="text-muted small">Lead time: @Model.Supplier.LeadTimeDays days</div>
                    </dd>

                    <dt class="col-sm-5">Price</dt>
                    <dd class="col-sm-7">₴@(Model.UnitPrice.ToString("N2"))</dd>

                    <dt class="col-sm-5">Stock</dt>
                    <dd class="col-sm-7">
                        @Model.StockQuantity
                        @if (Model.StockQuantity <= Model.MinStock)
                        {
                            <span class="badge text-bg-danger ms-1">Low stock</span>
                        }
                    </dd>

                    <dt class="col-sm-5">Min stock</dt>
                    <dd class="col-sm-7 mb-0">@Model.MinStock</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">Last 10 sales</div>
            @if (recentSales.Count == 0)
            {
                <div class="card-body text-muted">This product has not been sold yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Receipt #</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Sum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in recentSales)
                            {
                                <tr>
                                    <td>@item.Sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@item.SaleId">#@(item.SaleId)</a></td>
                                    <td class="text-end">@item.Quantity</td>
                                    <td class="text-end">₴@(item.UnitPrice.ToString("N2"))</td>
                                    <td class="text-end">₴@((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
