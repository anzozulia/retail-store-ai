@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card">
    <div class="card-body">
        <h1 class="h3 text-danger">Something went wrong</h1>
        <p class="mb-0">An error occurred while processing your request. Please go back and try again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mt-2 mb-0">Request ID: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
